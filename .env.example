# Copy to .env and adjust. Every value is optional for docker-compose.yml (full stack);
# docker-compose.addon.yml (existing Jellyfin) needs the ones marked [addon].

# User the containers run as. Jellyfin and ytm-sidecar MUST use the same user.
# 0:0 (root) works out of the box. To use your own user (id -u / id -g), create the
# ./data folders first and chown them to that user.
PUID=0
PGID=0
TZ=Etc/UTC

# ---- full stack (docker-compose.yml) ----
JELLYFIN_VERSION=12.4          # the plugin is built for Jellyfin 12.4
JELLYFIN_PORT=8096
JELLYFIN_CONFIG_PATH=./data/jellyfin/config
JELLYFIN_CACHE_PATH=./data/jellyfin/cache
MUSIC_PATH=./data/music        # your existing music collection (optional)
YOUTUBE_PATH=./data/youtube    # per-user liked songs (managed by the plugin)

# ---- existing Jellyfin (docker-compose.addon.yml) ----
# [addon] Host folder that holds Jellyfin's plugins (contains "configurations/").
#         Official image: <your config>/plugins   linuxserver image: <your config>/data/plugins
# JELLYFIN_PLUGINS_PATH=/srv/jellyfin/config/plugins
# [addon] Host folder for the liked songs; mount it into Jellyfin at LIBRARY_ROOT_PATH too.
# YOUTUBE_PATH=/srv/media/YouTube
# [addon] Docker network your Jellyfin container is attached to.
# JELLYFIN_NETWORK=jellyfin_default
# Where Jellyfin sees YOUTUBE_PATH (only used when the plugin is installed the first time).
# LIBRARY_ROOT_PATH=/media/YouTube

# Songs downloaded at the same time during a likes import.
MAX_CONCURRENT_DOWNLOADS=10
